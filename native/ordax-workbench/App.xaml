<Application x:Class="Ordax.Workbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#071019"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0B1724"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#101E2D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0E1A28"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#20334A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDF4FC"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#91A4BC"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#67A7FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#17375B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#55D6A9"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F6C76A"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#122238"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="#315F91"/>
      <Setter Property="Foreground" Value="#DCEBFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#07111B"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#112033"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource BgBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="#0B1623"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
          <Setter Property="Background" Value="#12243A"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>

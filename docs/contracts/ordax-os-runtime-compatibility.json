    "canonical_repository": "ordaxsystems/ordax-runtime",
    "historical_repository": "washingtonmsdj/mcp-blender",
    "historical_repository_is_provenance_only": true,
    "redirect_dependency_allowed": false,
    "mirror_repository_allowed": false,
    "dual_authority_allowed": false,
    "rename_during_transfer_allowed": false,
    "downstream_repository_targets": {
      "studio_source_current": "washingtonmsdj/ordax-apps",
      "studio_source_target": "ordaxsystems/ordax-apps"
    },
    "completed_requirements": [
      "target-organization-membership-confirmed",
      "open-prs-audited",
      "main-sha-recorded",
      "ci-green-before-transfer",
      "repository-transfer-complete"
    ],
    "pending_requirements": [
      "runtime-contracts-green-after-repoint",
      "consumer-remotes-repointed"
    ]

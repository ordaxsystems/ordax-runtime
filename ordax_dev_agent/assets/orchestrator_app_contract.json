            "maxLength": 180,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "projectId",
          "taskId"
        ]
      },

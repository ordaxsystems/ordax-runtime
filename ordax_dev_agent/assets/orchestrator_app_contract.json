    {
      "name": "orchestrator_work_send",
      "operation": "work_send",
      "description": "Send one authorized prompt through the existing App executor. An uncertain command must never be replayed.",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "draftRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "requestId",
          "projectId",
          "taskId",
          "content"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }

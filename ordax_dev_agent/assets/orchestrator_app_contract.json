    {
      "name": "orchestrator_work_get",
      "operation": "work_get",
      "description": "Inspect a scoped work and its provider segments without browser navigation.",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
